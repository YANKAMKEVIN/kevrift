{
  "name": "kevrift",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "npm run types && npm run unit && npm run build && npm run e2e",
    "types": "tsc -p .",
    "unit": "vitest run",
    "unit:watch": "vitest",
    "bot": "node tools/bot.mjs",
    "build": "vite build",
    "e2e": "npm run smoke && npm run smoke:dist && npm run partie",
    "smoke": "node tests/smoke.mjs",
    "smoke:dist": "SITE_DIR=dist SMOKE_PLAY_MS=8000 node tests/smoke.mjs",
    "partie": "node tests/partie.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
